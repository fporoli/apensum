{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "api: prepare",
      "detail": "Postgres/Mailpit up, stop a leftover API on 8001, build the API (one terminal).",
      "type": "shell",
      "command": "npm run dev:up && node scripts/free-port.mjs 8001 && npm run build --workspace=@worktime3/api",
      "problemMatcher": [
        "$tsc"
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "group": "dev",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "api: wait",
      "type": "shell",
      "command": "node scripts/wait-for-api.mjs http://localhost:8001/api/v1/health",
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "panel": "shared",
        "close": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "web: dev server + API",
      "dependsOn": [
        "web: dev server",
        "api: wait"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "web: dev server",
      "type": "shell",
      "command": "npm run dev --workspace=@worktime3/web",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev"
      }
    },
    {
      "label": "local: stack up",
      "type": "shell",
      "command": "npm run local:up",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "local"
      }
    },
    {
      "label": "local: stack down",
      "type": "shell",
      "command": "npm run local:down",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "local"
      }
    },
    {
      "label": "dev: services up",
      "type": "shell",
      "command": "npm run dev:up",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev"
      }
    },
    {
      "label": "dev: services down",
      "type": "shell",
      "command": "npm run dev:down",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev"
      }
    }
  ]
}
