<?xml version="1.0" encoding="UTF-8"?>
<!--
  The expenses plugin's changelog, run after the core's (infra/liquibase/apensum-migrate.sh).
  Same rules as the core's: a new NNN-*.sql file per change, never edit an applied changeset.
  Changesets are recorded as "expenses/changelog/<file>"; use the author "expenses".
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <include file="001-permissions.sql" relativeToChangelogFile="true"/>
    <include file="002-default-exchange-rates.sql" relativeToChangelogFile="true"/>
    <include file="003-role-scopes.sql" relativeToChangelogFile="true"/>

</databaseChangeLog>
