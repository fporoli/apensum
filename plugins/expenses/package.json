{
  "name": "@worktime3/expenses",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "Expenses, expense reports, exchange rates, mileage and receipt recognition (bundled Apensum plugin)",
  "apensum": {
    "id": "expenses",
    "permissions": [
      { "id": "nav.expenses", "kind": "nav", "scopes": ["own", "team", "reports", "all"], "caption": "nav.expenses" },
      { "id": "nav.expenseReports", "kind": "nav", "scopes": ["own", "team", "reports", "all"], "caption": "nav.expenseReports" },
      { "id": "nav.expenseProcessing", "kind": "nav", "scopes": ["all"], "caption": "nav.expenseProcessing" }
    ],
    "module": {
      "id": "expenses",
      "caption": "modules.expenses",
      "defaultEnabled": true,
      "objects": ["nav.expenses", "nav.expenseReports", "nav.expenseProcessing"]
    },
    "api": "dist/api/index.js",
    "web": "web/index.tsx"
  }
}
