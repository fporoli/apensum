<?xml version="1.0" encoding="UTF-8"?>
<!--
  The cases plugin's changelog, run after the core's (infra/liquibase/apensum-migrate.sh).
  Same rules as the core's: a new NNN-*.sql file per change, never edit an applied changeset.
  Changesets are recorded as "cases/changelog/<file>"; use the author "cases". The schema `cases`
  and its tables came with the core's changelogs 071-076 before Cases became a plugin; new changes
  to them go here.
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <include file="001-permissions.sql" relativeToChangelogFile="true"/>
    <include file="002-case-keys.sql" relativeToChangelogFile="true"/>
    <include file="003-encrypted-fields.sql" relativeToChangelogFile="true"/>
    <include file="004-encrypted-documents.sql" relativeToChangelogFile="true"/>
    <include file="005-assessment-archive.sql" relativeToChangelogFile="true"/>
    <include file="006-custom-fields-to-templates.sql" relativeToChangelogFile="true"/>

</databaseChangeLog>
