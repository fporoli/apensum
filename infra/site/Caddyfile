# Caddy inside the apensum-site container: serves the static website (apps/site, built into
# /srv/current by infra/site/remote.sh) over plain HTTP to the shared edge Caddy, which does TLS.
{
	admin localhost:2019
	auto_https off
}

:80 {
	root * /srv/current
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		# Own scripts only (assets/reveal.js); inline style attributes are used for the mock-up's bar heights.
		# form-action: the contact form posts to the Apensum API (SITE_FORM_ACTION, its origin, set by
		# remote.sh in .env, plus 'self': browsers also check the API's redirect back to the thank-you page). connect-src: contact.js sends it there with fetch
		# (SITE_CONNECT_SRC: 'self' plus that origin); news.js loads the news from there too, and their pictures
		# (SITE_IMG_SRC: that origin, empty without an API).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: {$SITE_IMG_SRC}; frame-ancestors 'none'; base-uri 'self'; form-action 'self' {$SITE_FORM_ACTION}; connect-src {$SITE_CONNECT_SRC}"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	# site.css is referenced with ?v=<hash>, so it can be cached for long.
	@assets path /assets/* /favicon.svg
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@pages not path /assets/* /favicon.svg
	header @pages Cache-Control "public, max-age=300"

	# / goes to the visitor's language (first entry of Accept-Language), German otherwise.
	@root path /
	handle @root {
		header Vary Accept-Language
		@fr header_regexp Accept-Language ^\s*fr
		@it header_regexp Accept-Language ^\s*it
		@en header_regexp Accept-Language ^\s*en
		route {
			redir @fr /fr/ 302
			redir @it /it/ 302
			redir @en /en/ 302
			redir * /de/ 302
		}
	}

	handle {
		file_server
	}

	handle_errors {
		@404 expression {err.status_code} == 404
		handle @404 {
			rewrite * /404.html
			file_server
		}
	}
}
